# Copy to .env and configure before first startup. No real credentials here.
APP_NAME=erp_foundation
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql://erp:replace_me@127.0.0.1:5432/erp_foundation
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=replace_with_a_long_random_secret_before_starting
DEFAULT_TENANT_NO=default
DEFAULT_TENANT_NAME=示例组织
INIT_ADMIN_EMAIL=admin@admin.com
INIT_ADMIN_PASSWORD=replace_with_your_initial_admin_password
FILE_STORAGE_BACKEND=local

# 可选：本部署的服务号二维码，填入可访问的 HTTPS 图片地址。
WECHAT_OFFICIAL_QR_CODE_URL=

# 桌面智能助手：仅在后端配置；留空时模型网关返回 503，不影响普通业务页面。
# 密钥不得进入前端构建产物、插件包或 Electron 安装包。
LLM_GATEWAY_DEEPSEEK_API_KEY=
LLM_GATEWAY_UPSTREAM_BASE_URL=https://api.deepseek.com/anthropic
LLM_GATEWAY_SEARCH_BASE_URL=https://api.deepseek.com
LLM_GATEWAY_ALLOWED_MODELS=["deepseek-flash"]
# 临时网关凭据有效期（秒），客户端会自动续期，不是对话时长限制。
LLM_GATEWAY_CREDENTIAL_TTL_SECONDS=600
# 每个登录身份的模型与联网搜索请求次数上限；多轮任务会产生多次请求。
LLM_GATEWAY_REQUESTS_PER_MINUTE=30
LLM_GATEWAY_REQUESTS_PER_DAY=1000
# 单次输出 token 上限，与当前桌面客户端配置一致；不是输入上下文长度。
LLM_GATEWAY_MAX_OUTPUT_TOKENS=393216
# 单次 JSON 请求体上限（字节）：33554432 = 32 MiB，含上下文和内嵌附件。
# 超限返回 413，不会截断后继续请求；此值不改变上游模型的上下文限制。
LLM_GATEWAY_MAX_REQUEST_BYTES=33554432

# Harness 查询：保留配置项，目前鉴权使用用户登录身份，此项不参与鉴权。
HARNESS_QUERY_KEY=
# 最多允许的 JOIN 次数（1～32），不计主表；修改后重新同步索引并重启后端。
HARNESS_QUERY_MAX_JOINS=8

# Harness 表/API 资源索引：填写完整的 OpenAI 兼容 embeddings 接口地址。
# 与上面的对话网关独立配置；不向客户端分发密钥。
HARNESS_EMBEDDING_URL=
HARNESS_EMBEDDING_API_KEY=
HARNESS_EMBEDDING_MODEL=
# 必须与向量服务实际返回的维度一致；更换模型或维度后重新构建索引。
HARNESS_EMBEDDING_DIMENSIONS=1024
HARNESS_EMBEDDING_BATCH_SIZE=16
# 服务不支持 dimensions 参数时设为 false，返回维度仍须与上面的配置一致。
HARNESS_EMBEDDING_SEND_DIMENSIONS=true
HARNESS_DISCOVERY_TIMEOUT_SECONDS=10
HARNESS_DISCOVERY_RECALL_LIMIT=30
HARNESS_DISCOVERY_LEXICAL_ENABLED=true

# 可选重排序；URL 和模型留空时不启用，不影响 embedding 建索引。
# 协议按实际服务选择 compatible 或 dashscope，URL 填完整重排序端点。
HARNESS_RERANK_PROTOCOL=compatible
HARNESS_RERANK_URL=
HARNESS_RERANK_API_KEY=
HARNESS_RERANK_MODEL=
# 服务需要排序指令时再取消注释并填写，不要设置为空字符串。
# HARNESS_RERANK_INSTRUCT=Rank resource definitions by relevance to the query.
