# 复制到 backend/config/plugin/mes.env 后填写，实际文件不提交、不打包。
# 修改后重启后端；进程环境变量优先，兼容旧 backend/.env 中的 MES_CNC_*。
MES_CNC_STORAGE_DIR=storage/mes-cnc
# 每个后端进程的核价并发通道数，范围 1～16。
MES_CNC_MAX_CONCURRENT_JOBS=1
MES_CNC_ANALYSIS_TIMEOUT_SECONDS=240
# 留空时沿用后端 LLM_GATEWAY_DEEPSEEK_API_KEY；可单独填写 MES 模型密钥。
MES_CNC_AI_API_KEY=
MES_CNC_AI_BASE_URL=https://api.deepseek.com
MES_CNC_AI_MODEL=deepseek-flash
MES_CNC_AI_REQUEST_TIMEOUT=120
MES_CNC_AI_TOTAL_TIMEOUT=360
# OCR 凭据仅在目标环境填写。
MES_CNC_PADDLEOCR_ACCESS_TOKEN=
MES_CNC_PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com
MES_CNC_PADDLEOCR_MODEL=PaddleOCR-VL-1.6
MES_CNC_PADDLEOCR_POLL_TIMEOUT=600
